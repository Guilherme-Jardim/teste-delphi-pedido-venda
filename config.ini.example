; Modelo do config.ini (fica na raiz do projeto).
;
; Voce nao precisa criar este arquivo a mao: na primeira execucao o sistema abre uma tela
; de configuracao ja preenchida e grava o config.ini sozinho. Se preferir, copie este
; arquivo para config.ini e ajuste os valores. O config.ini real nao e versionado.

[Database]
; Arquivo .fdb, como o servidor Firebird enxerga. Pode ser em qualquer pasta;
; se o arquivo nao existir, o sistema cria (e cria a pasta, se for preciso).
Database=C:\ProgramData\PedidoVenda\dados\PEDIDOS.FDB
Username=SYSDBA
Password=sua_senha_aqui
; Deixe Server vazio para conexao embarcada/local sem TCP
Server=localhost
Port=3050
; Caminho da fbclient.dll (relativo a este arquivo ou absoluto).
; Use bin\Win32 para 32 bits e bin\Win64 para 64 bits.
ClientLibrary=bin\Win32\fbclient.dll
